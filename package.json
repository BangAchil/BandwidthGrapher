{
  "name": "@king-olt/bandwidth-grapher",
  "version": "0.0.0",
  "private": true,
  "description": "Custom bandwidth chart library for KING OLT.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ././src/index.ts ././src/react/index.ts --format esm,cjs --dts",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "latest",
    "eslint": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "keywords": [
    "bandwidth",
    "chart",
    "canvas",
    "king-olt",
    "network-monitoring"
  ],
  "license": "UNLICENSED"
}
